generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// 1. Users Table
model User {
    id              String   @id @default(uuid(7)) @map("user_id")
    displayName     String   @map("display_name") @db.VarChar(50)
    email           String?  @unique @db.VarChar(100)
    passwordHash    String?  @map("password_hash") @db.VarChar(255)
    googleId        String?  @unique @map("google_id")
    avatar          String?  @map("avatar_url") // (Upload or Google)
    role            Role     @default(USER)
    isEmailVerified Boolean  @default(false) @map("is_email_verified")
    isActive        Boolean  @default(true) @map("is_active")
    createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

    // Relations
    profile         UserProfile?
    createdStories  Story[]          @relation("UserCreatedStories")
    flashcards      UserFlashcard[]
    refreshTokens   RefreshToken[]
    inventory       UserInventory[]
    userAppearances UserAppearance[]

    @@map("users")
}

enum Role {
    USER
    ADMIN
}

// RefreshToken Table (Auth - JWT)
model RefreshToken {
    id          String @id @default(uuid(7))
    hashedToken String @unique @map("hashed_token")
    userId      String @map("user_id")
    user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    expiresAt DateTime @map("expires_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@map("refresh_tokens")
}

// 2. User Profiles Table (Game Stats & Equipped Items)
model UserProfile {
    userId String @id @map("user_id")

    // Game Stats
    level     Int @default(1)
    currentXp Int @default(0) @map("current_xp")
    gold      Int @default(0)

    // Energy & Streak System
    streakCount      Int       @default(0) @map("streak_count")
    lastStudyDate    DateTime? @map("last_study_date") @db.Timestamptz
    energy           Int       @default(5)
    lastEnergyUpdate DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("user_profiles")
}

// 2. User Appearance (Specializing in equipment/fashion management)
model UserAppearance {
    userId String @id @map("user_id")

    // Equipment
    avatarFrameId     String? @map("avatar_frame_id")
    mascotSkinId      String? @map("mascot_skin_id")
    flashcardThemeId  String? @map("flashcard_theme_id")
    collectionFrameId String? @map("collection_frame_id")

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    avatarFrame     Item? @relation("EquippedAvatarFrame", fields: [avatarFrameId], references: [id])
    mascotSkin      Item? @relation("EquippedMascotSkin", fields: [mascotSkinId], references: [id])
    flashcardTheme  Item? @relation("EquippedCardTheme", fields: [flashcardThemeId], references: [id])
    collectionFrame Item? @relation("EquippedCollectionFrame", fields: [collectionFrameId], references: [id])

    @@map("user_appearances")
}

// 3. Bảng Stories (Kho Truyện)
model Story {
    id              String  @id @default(uuid(7)) @map("story_id")
    title           String  @db.VarChar(200)
    contentJson     Json    @map("content_json") // Cấu trúc Token/Paragraph
    rawContent      String? @map("raw_content") // Text thuần để search
    genre           String? @db.VarChar(50)
    difficultyLevel String? @map("difficulty_level") @db.VarChar(20)

    readingTime Int? @map("reading_time") // Số phút đọc ước tính
    wordCount   Int? @map("word_count") // Tổng số từ

    // AI Tracking
    isAiGenerated Boolean @default(false) @map("is_ai_generated")
    userPrompt    String? @map("user_prompt") // Prompt gốc user nhập

    creatorId String? @map("creator_id")

    coverImage String?  @map("cover_image") @db.VarChar(255)
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

    creator    User?           @relation("UserCreatedStories", fields: [creatorId], references: [id], onDelete: SetNull)
    flashcards UserFlashcard[]

    questions Question[]

    @@index([title])
    @@map("stories")
}

// 4. Question Table (Quiz after Reading Story)
model Question {
    id      String @id @default(uuid(7)) @map("question_id")
    storyId String @map("story_id")

    content String @db.Text // Nội dung câu hỏi

    // Lưu options dưới dạng JSON cho gọn vì MVP không cần quá phức tạp
    // Cấu trúc: [{"id": 1, "text": "Answer A", "isCorrect": false}, {"id": 2, "text": "Answer B", "isCorrect": true}]
    options Json

    explanation String? @db.Text // Giải thích tại sao đúng (cho user xem sau khi làm)

    story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

    @@map("questions")
}

// 5. Vocabularies Table
model Vocabulary {
    id             String  @id @default(uuid(7)) @map("vocab_id")
    word           String  @db.VarChar(100)
    generalMeaning String? @map("general_meaning")
    ipa            String? @db.VarChar(100)
    audioUrl       String? @map("audio_url") @db.VarChar(255)
    pos            String? @db.VarChar(20) // Noun, Verb, Adj...

    flashcards UserFlashcard[]

    @@unique([word, pos], name: "unique_word_pos")
    @@index([word])
    @@map("vocabularies")
}

// 6. Bảng User Flashcards (Core FSRS - Context Aware)
model UserFlashcard {
    id String @id @default(uuid(7)) @map("card_id")

    userId        String  @map("user_id")
    vocabId       String  @map("vocab_id")
    sourceStoryId String? @map("source_story_id")

    meaningInContext String  @map("meaning_in_context") // Nghĩa cụ thể trong ngữ cảnh
    contextSentence  String? @map("context_sentence")

    // FSRS Params
    state          Int   @default(0) // 0: New, 1: Learning, 2: Review, 3: Relearning
    stability      Float @default(0)
    difficulty     Float @default(0)
    elapsedDays    Int   @default(0) @map("elapsed_days")
    scheduledDays  Int   @default(0) @map("scheduled_days")
    retrievability Float @default(0)

    lastReview DateTime? @map("last_review") @db.Timestamptz
    dueDate    DateTime  @default(now()) @map("due_date") @db.Timestamptz

    isMastered Boolean  @default(false) @map("is_mastered")
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    vocabulary  Vocabulary  @relation(fields: [vocabId], references: [id], onDelete: Cascade)
    sourceStory Story?      @relation(fields: [sourceStoryId], references: [id], onDelete: SetNull)
    reviewLogs  ReviewLog[]

    @@index([userId, dueDate])
    @@map("user_flashcards")
}

// 7. Bảng Review Logs (Lịch sử học)
model ReviewLog {
    id String @id @default(uuid(7)) @map("log_id")

    cardId String @map("card_id")

    rating         Int // 1: Again, 2: Hard, 3: Good, 4: Easy
    reviewDuration Int?     @map("review_duration") // Milliseconds
    reviewedAt     DateTime @default(now()) @map("reviewed_at") @db.Timestamptz

    flashcard UserFlashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

    @@map("review_logs")
}

// 8. Bảng Items (Shop System)
model Item {
    id          String   @id @default(uuid(7)) @map("item_id")
    name        String   @db.VarChar(100)
    description String?
    type        ItemType
    price       Int
    imageUrl    String?  @map("image_url") @db.VarChar(255)

    // Lưu thông số: { "energy_bonus": 5 } hoặc { "asset_url": "cat_skin.glb" }
    properties Json? @map("properties")

    isAiGeneratedReward Boolean @default(false) @map("is_ai_generated_reward")

    owners               UserInventory[]
    equippedAvatarFrames UserAppearance[] @relation("EquippedAvatarFrame")
    equippedMascotSkins  UserAppearance[] @relation("EquippedMascotSkin")
    equippedCardThemes   UserAppearance[] @relation("EquippedCardTheme")
    collectionFrames     UserAppearance[] @relation("EquippedCollectionFrame")

    @@map("items")
}

enum ItemType {
    AVATAR_FRAME // Khung avatar
    MASCOT_SKIN // Skin cho mèo
    CARD_THEME // Hình nền cho thẻ Flashcard
    ENERGY_MAX_UPGRADE // Tăng giới hạn năng lượng (Vật phẩm thụ động/Consumable)
    ENERGY_REFILL // Hồi đầy năng lượng (Consumable)
}

// 9. Bảng User Inventory (Túi đồ)
model UserInventory {
    id String @id @default(uuid(7)) @map("inventory_id")

    userId String @map("user_id")
    itemId String @map("item_id")

    quantity   Int     @default(1) // Số lượng (Dùng cho bình năng lượng)
    isEquipped Boolean @default(false) @map("is_equipped")

    acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

    @@map("user_inventory")
}
// 10. User Progress Table (Tracks user's progress on stories and questions)
model UserProgress {
    id String @id @default(uuid(7)) @map("progress_id")

    userId  String @map("user_id")
    storyId String @map("story_id")

    // Story Progress
    lastReadSentence Int       @default(0) @map("last_read_sentence")
    isStoryCompleted Boolean   @default(false) @map("is_story_completed")
    storyCompletedAt DateTime? @map("story_completed_at") @db.Timestamptz

    // Quiz Progress
    quizScore        Int?      @map("quiz_score")
    totalQuestions   Int?      @map("total_questions")
    quizCompletedAt  DateTime? @map("quiz_completed_at") @db.Timestamptz
    lastQuizAttempt  DateTime? @map("last_quiz_attempt") @db.Timestamptz

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

    @@unique([userId, storyId], name: "unique_user_story_progress")
    @@map("user_progress")
}
