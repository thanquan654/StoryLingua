generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// 1. Users Table
model User {
    id              String   @id @default(uuid(7)) @map("user_id")
    displayName     String   @map("display_name") @db.VarChar(50)
    email           String?  @unique @db.VarChar(100)
    passwordHash    String?  @map("password_hash") @db.VarChar(255)
    googleId        String?  @unique @map("google_id")
    avatar          String?  @map("avatar_url") // (Upload or Google)
    role            Role     @default(USER)
    isEmailVerified Boolean  @default(false) @map("is_email_verified")
    isActive        Boolean  @default(true) @map("is_active")
    createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
    updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

    // Relations
    profile            UserProfile?
    createdStories     Story[]            @relation("UserCreatedStories")
    flashcards         UserFlashcard[]
    refreshTokens      RefreshToken[]
    inventory          UserInventory[]
    userAppearances    UserAppearance[]
    userStoryHistories UserStoryHistory[]
    reviewLogs         ReviewLog[]

    @@map("users")
}

enum Role {
    USER
    ADMIN
}

// RefreshToken Table (Auth - JWT)
model RefreshToken {
    id          String @id @default(uuid(7))
    hashedToken String @unique @map("hashed_token")
    userId      String @map("user_id")
    user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    expiresAt DateTime @map("expires_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@map("refresh_tokens")
}

// 2. User Profiles Table (Game Stats & Equipped Items)
model UserProfile {
    userId String @id @map("user_id")

    // Game Stats
    level     Int @default(1)
    currentXp Int @default(0) @map("current_xp")
    gold      Int @default(0)

    // Energy & Streak System
    streakCount      Int       @default(0) @map("streak_count")
    lastStudyDate    DateTime? @map("last_study_date") @db.Timestamptz
    energy           Int       @default(5)
    lastEnergyUpdate DateTime  @default(now()) @db.Timestamptz

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("user_profiles")
}

// 3. User Appearance (Specializing in equipment/fashion management)
model UserAppearance {
    userId String @id @map("user_id")

    // Equipment
    avatarFrameId     String? @map("avatar_frame_id")
    mascotSkinId      String? @map("mascot_skin_id")
    flashcardThemeId  String? @map("flashcard_theme_id")
    collectionFrameId String? @map("collection_frame_id")

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    avatarFrame     Item? @relation("EquippedAvatarFrame", fields: [avatarFrameId], references: [id], onDelete: SetNull)
    mascotSkin      Item? @relation("EquippedMascotSkin", fields: [mascotSkinId], references: [id], onDelete: SetNull)
    flashcardTheme  Item? @relation("EquippedCardTheme", fields: [flashcardThemeId], references: [id], onDelete: SetNull)
    collectionFrame Item? @relation("EquippedCollectionFrame", fields: [collectionFrameId], references: [id], onDelete: SetNull)

    @@map("user_appearances")
}

// 4. Stories Table (Core Content)
model Story {
    id                 String             @id @default(uuid(7)) @map("story_id")
    title              String             @db.VarChar(200)
    /**
     * * Stores the tokenized content for the interactive reader.
     * Structure: Array of Paragraphs -> Array of Tokens.
     * * Example JSON:
     * [
     * {
     * "id": "para_1",
     * "tokens": [
     * { "t": "Hello", "l": "hello", "pos": "INTJ", "s": " " },
     * { "t": "world", "l": "world", "pos": "NOUN", "s": "." }
     * ]
     * }
     * ]
     * * Legend:
     * - t: text (original word)
     * - l: lemma (root form for dictionary lookup)
     * - pos: part of speech (optional, for coloring)
     * - s: suffix (space or punctuation after the word)
     */
    contentJson        Json               @map("content_json")
    rawContent         String?            @map("raw_content") @db.Text
    genre              String?            @db.VarChar(50)
    difficultyLevel    String?            @map("difficulty_level") @db.VarChar(2)
    readingTime        Int?               @map("reading_time") // Unit: Minutes
    wordCount          Int?               @map("word_count") // Total distinct words
    isAiGenerated      Boolean            @default(false) @map("is_ai_generated")
    userPrompt         String?            @map("user_prompt") @db.Text
    creatorId          String?            @map("creator_id")
    coverImage         String?            @map("cover_image") @db.VarChar(255)
    status             StoryStatus        @default(DRAFT)
    createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
    updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
    // Relations
    creator            User?              @relation("UserCreatedStories", fields: [creatorId], references: [id], onDelete: SetNull)
    flashcards         UserFlashcard[]
    questions          Question[]
    userStoryHistories UserStoryHistory[]

    // Indexes for Search & Filtering
    @@index([title])
    @@index([genre])
    @@index([difficultyLevel])
    @@map("stories")
}

enum StoryStatus {
    DRAFT // User created but not posted
    PUBLISHED // Visible to everyone
    PRIVATE // Only visible to creator
    ARCHIVED // Soft deleted
}

// 5. Question Table (Quiz after Reading Story)
model Question {
    id          String       @id @default(uuid(7)) @map("question_id")
    storyId     String       @map("story_id")
    type        QuestionType @default(MULTIPLE_CHOICE)
    content     String       @db.Text
    data        Json
    explanation String?      @db.Text
    orderIndex  Int          @default(0) @map("order_index")

    story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

    @@map("questions")
}

enum QuestionType {
    MULTIPLE_CHOICE
    FILL_IN_THE_BLANK
    MATCHING
    SORTING
}

// 6. User Story History
model UserStoryHistory {
    id          String    @id @default(uuid(7))
    userId      String    @map("user_id")
    storyId     String    @map("story_id")
    isRead      Boolean   @default(false) @map("is_read")
    quizScore   Int?      @map("quiz_score")
    lastReadAt  DateTime  @default(now()) @map("last_read_at") @db.Timestamptz
    completedAt DateTime? @map("completed_at") @db.Timestamptz

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

    @@unique([userId, storyId])
    @@map("user_story_histories")
}

// 7. Vocabularies Table
model Vocabulary {
    id              String  @id @default(uuid(7)) @map("vocab_id")
    word            String  @db.VarChar(100)
    definition      String? @db.Text
    exampleSentence String? @map("example_sentence") @db.Text
    ipa             String? @db.VarChar(100)
    audioUrl        String? @map("audio_url") @db.VarChar(255)
    pos             String? @db.VarChar(20) // Noun, Verb, Adj...

    flashcards UserFlashcard[]

    @@unique([word, pos], name: "unique_word_pos")
    @@index([word])
    @@map("vocabularies")
}

// 8. User Flashcards (Core FSRS)
model UserFlashcard {
    id String @id @default(uuid(7)) @map("card_id")

    userId           String    @map("user_id")
    vocabId          String    @map("vocab_id")
    sourceStoryId    String?   @map("source_story_id")
    meaningInContext String?   @map("meaning_in_context") @db.Text
    // Example sentence from the story (Context)
    contextSentence  String?   @map("context_sentence") @db.Text
    // Personal note
    note             String?   @db.Text
    // --- FSRS Parameters ---
    state            CardState @default(NEW)
    stability        Float     @default(0)
    difficulty       Float     @default(0)
    elapsedDays      Int       @default(0) @map("elapsed_days")
    scheduledDays    Int       @default(0) @map("scheduled_days")

    lastReview DateTime? @map("last_review") @db.Timestamptz
    dueDate    DateTime  @default(now()) @map("due_date") @db.Timestamptz

    isMastered Boolean  @default(false) @map("is_mastered")
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    vocabulary  Vocabulary  @relation(fields: [vocabId], references: [id], onDelete: Cascade)
    sourceStory Story?      @relation(fields: [sourceStoryId], references: [id], onDelete: SetNull)
    reviewLogs  ReviewLog[]

    @@index([userId, dueDate])
    @@map("user_flashcards")
}

enum CardState {
    NEW // 0
    LEARNING // 1
    REVIEW // 2
    RELEARNING // 3
}

// 9. Review Logs
model ReviewLog {
    id String @id @default(uuid(7)) @map("log_id")

    userId String @map("user_id")

    cardId String @map("card_id")

    rating Int

    // [IMPORTANT FOR FSRS] Snapshot of data at the time of review
    // Helps run the FSRS Optimizer later to find the most optimal w[] parameter set
    state         CardState // State of the card at review time (New/Learning/Review...)
    scheduledDays Int       @map("scheduled_days") // How many days it should have been studied after
    elapsedDays   Int       @map("elapsed_days") // How many days it was actually studied after
    stability     Float // Memory stability (After review)
    difficulty    Float // Difficulty (After review)

    reviewDuration Int?     @map("review_duration") // Milliseconds (To detect cheating)
    reviewedAt     DateTime @default(now()) @map("reviewed_at") @db.Timestamptz

    // Relations
    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    flashcard UserFlashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

    @@index([userId, reviewedAt])
    @@map("review_logs")
}

// 10. Items (Simple Shop System)
model Item {
    id          String  @id @default(uuid(7)) @map("item_id")
    name        String  @db.VarChar(100)
    description String? @db.Text

    type ItemType

    price    Int
    currency Currency @default(GOLD)

    // Original price (to display promotions if desired, e.g., Price 100, crossed out to 80)
    originalPrice Int? @map("original_price")

    imageUrl String? @map("image_url") @db.VarChar(255)

    // JSON containing parameters (e.g., { "energy": 5 } or { "asset": "skin.png" })
    properties Json?

    saleStartAt DateTime? @map("sale_start_at") @db.Timestamptz
    saleEndAt   DateTime? @map("sale_end_at") @db.Timestamptz

    isActive Boolean @default(true) @map("is_active") // Admin can hide/show item

    isAiGeneratedReward Boolean @default(false) @map("is_ai_generated_reward")

    // Relations
    owners               UserInventory[]
    equippedAvatarFrames UserAppearance[] @relation("EquippedAvatarFrame")
    equippedMascotSkins  UserAppearance[] @relation("EquippedMascotSkin")
    equippedCardThemes   UserAppearance[] @relation("EquippedCardTheme")
    collectionFrames     UserAppearance[] @relation("EquippedCollectionFrame")

    @@index([type])
    @@map("items")
}

enum Currency {
    GOLD
}

enum ItemType {
    AVATAR_FRAME
    MASCOT_SKIN
    CARD_THEME
    COLLECTION_FRAME
    ENERGY_REFILL
    STREAK_FREEZE
    DOUBLE_XP_1H
}

// 11. User Inventory
model UserInventory {
    id String @id @default(uuid(7)) @map("inventory_id")

    userId String @map("user_id")
    itemId String @map("item_id")

    quantity Int @default(1)

    // Expiration date (Used for rented/trial items)
    // E.g., 7-day skin rental. A cron job will scan and delete/hide it upon expiration.
    expiresAt DateTime? @map("expires_at")

    acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

    // Each item in a user's inventory is unique (only the quantity increases)
    @@unique([userId, itemId])
    @@map("user_inventory")
}
